generator client {
  provider        = "prisma-client"
  previewFeatures = ["relationJoins", "typedSql"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Роли пользователей
enum UsersRole {
  USER
  ADMIN
  LIMITED_ADMIN
  LIMITED_ADMIN_GMU
}

/// Разделы библиотеки
enum LibraryType {
  DOCUMENTATION
  PRACTICE
}

/// Виды взаимодействий
enum InteractionType {
  GMU
  TNO
}

/// Виды изменений данных
enum ActionHistory {
  INSERT
  UPDATE
  DELETE
}

/// Виды активов
enum ActivesType {
  TRANSPORT
  PROPERTY
  GROUND
  DEBIT
  OTHER
}

/// Статус верификации выгрузки
enum DataStatus {
  AIS
  GMU
  AIS_GMU
  OLD_DATA
}

/// Статусы объекта
enum ObjectStatus {
  WANTED_BEGIN
  WANTED_END
  ARREST_BEGIN
  ARREST_END
  EVALUATION_BEGIN
  EVALUATION_END
  REALIZATION_FIRST_SUBMIT
  REALIZATION_FIRST
  NOT_REALIZATION_FIRST
  REALIZATION_SECOND_SUBMIT
  REALIZATION_SECOND
  NOT_REALIZATION_SECOND
  REFUND_PROPERTY
  COMPLAINT
  COMPLAINT_REVIEWED
  LEASING
  FORECLOSURE
  FORECLOSURE_CANCEL
  OTHER
}

/// Статусы лизинга
enum LeasStatus {
  IS_PLEDGE_HOLDER
  IS_NOT_PLEDGE_HOLDER
  NO_PLEDGE
}

/// Результаты розаска
enum WantedResults {
  FINDING_PROPERTY
  END_PROPERTY_SEARCH_ACTIVITIES
}

/// Этапы реализации
enum RealizationStage {
  FIRST
  SECOND
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "Пользователи сервиса"
model Users {
  id           Int       @id @default(autoincrement()) @db.UnsignedSmallInt
  login        String    @unique @db.VarChar(25)
  passwordHash String    @db.VarChar(255)
  role         UsersRole @default(USER)
  firstName    String?   @db.VarChar(100)
  lastName     String?   @db.VarChar(100)
  secondName   String?   @db.VarChar(100)

  regoinId Int?      @db.UnsignedSmallInt
  region   Regions?  @relation(fields: [regoinId], references: [id])
  history  History[]

  @@map("users")
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "История изменений в сервисе"
model History {
  id        Int           @id @default(autoincrement())
  tableName String        @db.VarChar(25)
  fieldName String        @db.VarChar(25)
  rowId     Int
  value     Json?         @db.Json
  action    ActionHistory
  stamp     DateTime      @default(now())

  userId Int   @db.UnsignedSmallInt
  user   Users @relation(fields: [userId], references: [id])

  @@map("history")
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица настройки сервиса - включение/выключение сервисного режима
model Settings {
  id          Int     @id @default(autoincrement()) @db.UnsignedTinyInt
  serviceMode Boolean @default(false)

  @@map("settings")
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "Библиотека"
model Library {
  id               Int         @id @default(autoincrement()) @db.UnsignedTinyInt
  source           LibraryType
  originalFilename String      @db.VarChar(255)
  systemsFilename  String?     @db.VarChar(255)

  @@map("library")
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "Взаимодействий"
model Interactions {
  id                 Int              @id @default(autoincrement())
  type               InteractionType?
  submissionDate     DateTime?        @db.Date
  reviewDate         DateTime?        @db.Date
  result             String?          @db.VarChar(50)
  note               String?          @db.Text
  originalFilename_1 String?          @db.VarChar(255)
  originalFilename_2 String?          @db.VarChar(255)
  systemsFilename_1  String?          @db.VarChar(255)
  systemsFilename_2  String?          @db.VarChar(255)

  tnoId    Int? @db.UnsignedSmallInt
  clientId Int

  tno    TNO?    @relation(fields: [tnoId], references: [id])
  client Clients @relation(fields: [clientId], references: [id])

  @@map("interactions")
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "СОСП"
model SOSP {
  id       Int    @id @default(autoincrement()) @db.UnsignedTinyInt
  CodeSOSP String @unique @db.VarChar(10)

  client Clients[]

  @@map("sosp")
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "ТНО"
model TNO {
  id      Int    @id @default(autoincrement()) @db.UnsignedSmallInt
  CodeTNO String @db.VarChar(4)

  regionId Int?     @db.UnsignedSmallInt
  region   Regions? @relation(fields: [regionId], references: [id])

  client      Clients[]
  interaction Interactions[]

  @@unique([CodeTNO, regionId])
  @@map("tno")
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "Регионы"
model Regions {
  id         Int     @id @default(autoincrement()) @db.UnsignedSmallInt
  regionCode String  @unique @db.VarChar(4)
  regionName String? @db.VarChar(128)
  sonoName   String? @db.VarChar(512)

  user Users[]
  tno  TNO[]

  @@map("regions")
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "Категории должников"
model ClientCategories {
  id       Int    @id @default(autoincrement()) @db.UnsignedTinyInt
  category String @unique @db.VarChar(10)

  client Clients[]

  @@map("client_categories")
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "Должники"
model Clients {
  id        Int     @id @default(autoincrement())
  inn       String  @unique @db.VarChar(12)
  name      String? @db.VarChar(512)
  isVisible Boolean @default(true)

  categoryId Int? @db.UnsignedTinyInt
  tnoId      Int? @db.UnsignedSmallInt
  sospId     Int? @db.UnsignedTinyInt

  category    ClientCategories? @relation(fields: [categoryId], references: [id])
  tno         TNO?              @relation(fields: [tnoId], references: [id])
  sosp        SOSP?             @relation(fields: [sospId], references: [id])
  interaction Interactions[]
  resolution  Resolutions[]
  active      Actives[]

  @@map("clients")
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "Постановления"
model Resolutions {
  id                            Int       @id @default(autoincrement())
  number                        String?   @db.VarChar(20)
  date                          DateTime? @db.Date
  amount                        Decimal?  @db.Decimal(15, 2)
  balance                       Decimal?  @db.Decimal(15, 2)
  WritExecutionNumber           String?   @db.VarChar(20)
  WritExecutionBeginDate        DateTime? @db.Date
  WritExecutionStopDate         DateTime? @db.Date
  WritExecutionEndDate          DateTime? @db.Date
  WritExecutionEndReason        String?   @db.VarChar(255)
  WritExecutionPostponementDate DateTime? @db.Date
  WritExecutionTerminateDate    DateTime? @db.Date
  isArchived                    Boolean?  @default(false)
  isDerived                     Boolean?  @default(false)
  isVisible                     Boolean   @default(true)

  clientId Int
  client   Clients @relation(fields: [clientId], references: [id])

  @@map("resolutions")
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "Активы должника"
model Actives {
  id                Int           @id @default(autoincrement())
  type              ActivesType
  status            DataStatus?
  objectStatus      ObjectStatus?
  otherObjectStatus String?       @db.VarChar(50)
  isVerified        Boolean?      @default(false)
  nameLessor        String?       @db.VarChar(255)
  isLeasing         LeasStatus?
  comment           String?       @db.Text
  uploadDate        DateTime?     @db.Date
  isVisible         Boolean       @default(true)

  clientId Int
  client   Clients @relation(fields: [clientId], references: [id])

  description      DescriptionActives?  @relation("Actives_Description")
  arrest           Arrests?             @relation("Actives_Arrests")
  wanted           Wanteds?             @relation("Actives_Wanteds")
  evaluation       Evaluations?         @relation("Actives_Evaluations")
  encumbrance      Encumbrances?        @relation("Actives_Encumbrances")
  realization      Realizations[]       @relation("Actives_Realizations")
  refundProperty   RefundProperty?      @relation("Actives_RefundProperty")
  debitForeclosure DebitForeclosure?    @relation("Actives_DebitForeclosure")
  registration     ActiveRegistrations? @relation("Actives_Registrations")
  complaint        Complaints?          @relation("Actives_Complaints")

  @@map("actives")
}

/// Таблица "Описание имущества"
model DescriptionActives {
  id   Int      @id @default(autoincrement())
  name String?  @db.Text
  cost Decimal? @db.Decimal(15, 2)

  // Характеристики транспорта:
  vin         String? @db.VarChar(255)
  stateNumber String? @db.VarChar(32)
  yearRelease Int?    @db.Year

  // Характеристики недвижимости/земельного участка:
  landArea        Float?  @db.Float
  cadastralNumber String? @db.VarChar(60)
  adress          String? @db.Text
  shareSize       Float?

  // Характеристики дебиторской задолжености:
  debitorInn    String?   @db.VarChar(12)
  debitorAdress String?   @db.Text
  debitorDate   DateTime? @db.Date

  active Actives @relation("Actives_Description", fields: [id], references: [id])

  @@map("description_actives")
}

/// Таблица "Арестов имущества"
model Arrests {
  id        Int       @id @default(autoincrement())
  beginDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  endReason String?   @db.Text
  amount    Decimal?  @db.Decimal(15, 2)

  activeId Int     @unique
  active   Actives @relation("Actives_Arrests", fields: [activeId], references: [id])

  @@map("arrests")
}

/// Таблица "Розысков имущества"
model Wanteds {
  id        Int            @id @default(autoincrement())
  beginDate DateTime?      @db.Date
  endDate   DateTime?      @db.Date
  result    WantedResults?

  activeId Int     @unique
  active   Actives @relation("Actives_Wanteds", fields: [activeId], references: [id])

  @@map("wanteds")
}

/// Таблица "Оценок имущества"
model Evaluations {
  id        Int       @id @default(autoincrement())
  beginDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  amount    Decimal?  @db.Decimal(15, 2)

  activeId Int     @unique
  active   Actives @relation("Actives_Evaluations", fields: [activeId], references: [id])

  @@map("evaluations")
}

/// Таблица "Обременений имущества"
model Encumbrances {
  id   Int       @id @default(autoincrement())
  type String?   @db.VarChar(250)
  date DateTime? @db.Date

  activeId Int     @unique
  active   Actives @relation("Actives_Encumbrances", fields: [activeId], references: [id])

  @@map("encumbrances")
}

/// Таблица "Реализаций имущества"
model Realizations {
  id                             Int              @id @default(autoincrement())
  stage                          RealizationStage
  submitDate                     DateTime?        @db.Date
  submitAmount                   Decimal?         @db.Decimal(15, 2)
  realizationDate                DateTime?        @db.Date
  realizationResultDate          DateTime?        @db.Date
  realizedPropertyAmount         Decimal?         @db.Decimal(15, 2)
  notificationNotRealizationDate DateTime?        @db.Date
  notRealizationReason           String?          @db.Text

  activeId Int
  active   Actives @relation("Actives_Realizations", fields: [activeId], references: [id])

  @@map("realizations")
}

/// Таблица "Возврат имущества должнику"
model RefundProperty {
  id     Int       @id @default(autoincrement())
  date   DateTime? @db.Date
  amount Decimal?  @db.Decimal(15, 2)

  activeId Int     @unique
  active   Actives @relation("Actives_RefundProperty", fields: [activeId], references: [id])

  @@map("refund_property")
}

/// Таблица "Обращении взыскания на дебиторскую задолженость"
model DebitForeclosure {
  id            Int       @id @default(autoincrement())
  requestDate   DateTime? @db.Date
  requestAmount Decimal?  @db.Decimal(15, 2)
  cancelDate    DateTime? @db.Date
  cancelReason  String?   @db.VarChar(512)

  activeId Int     @unique
  active   Actives @relation("Actives_DebitForeclosure", fields: [activeId], references: [id])

  @@map("debit_foreclosure")
}

/// Таблица "Регистраций активов"
model ActiveRegistrations {
  id        Int       @id @default(autoincrement())
  beginDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  activeId Int     @unique
  active   Actives @relation("Actives_Registrations", fields: [activeId], references: [id])

  @@map("active_registrations")
}

/// Таблица "Жалоб"
model Complaints {
  id             Int       @id @default(autoincrement())
  personWhoFiled String?   @db.VarChar(255)
  date           DateTime? @db.Date
  subject        String?   @db.VarChar(255)
  source         String?   @db.VarChar(255)
  result         String?   @db.Text

  activeId Int     @unique
  active   Actives @relation("Actives_Complaints", fields: [activeId], references: [id])

  @@map("complaints")
}
