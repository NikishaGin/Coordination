generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Роли пользователей
enum UsersRole {
  User
  Admin
  LimitedAdmin
  LimitedAdminGMU
}

/// Раздел библиотеки
enum LibraryType {
  Documentation
  Practice
}

/// Типы изменений данных
enum ActionHistory {
  Insert
  Update
  Delete
}

/// Виды активов
enum ActivesType {
  Transport
  Property
  Ground
  Debit
  Another
}

enum StatusObject {
  wanted_open
  wanted_close
  arrest
  evaluation_submit
  evaluation
  realization_submit_1
  realization_1
  not_realization_1
  realization_submit_2
  realization_2
  not_realization_2
  return_property_to_debtor
  arrest_end
  complaint
  complaint_has_been_reviewed
  leasing
  foreclosure
  foreclosure_cancel
  other
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "Пользователи"
model Users {
  id           Int       @id @default(autoincrement())
  role         UsersRole @default(User)
  login        String    @db.VarChar(50) @unique
  passwordHash String    @db.VarChar(255)
  firstName    String?   @db.VarChar(50)
  lastName     String?   @db.VarChar(50)
  secondName   String?   @db.VarChar(50)

  regoinId Int

  region  Regions   @relation(fields: [regoinId], references: [id])
  history History[]
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "История изменений"
model History {
  id        Int           @id @default(autoincrement())
  tableName String        @db.VarChar(50)
  fieldName String        @db.VarChar(50)
  rowId     Int
  value     Json?         @db.Json
  action    ActionHistory
  stamp     DateTime      @default(now())

  userId Int

  user Users @relation(fields: [userId], references: [id])
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица настройки сервиса - включение/выключение сервисного режима
model Settings {
  id          Int     @id @default(autoincrement())
  serviceMode Boolean @default(false)
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "Библиотека"
model Library {
  id               Int         @id @default(autoincrement())
  source           LibraryType
  originalFilename String      @db.VarChar(255)
  systemsFilename  String?     @db.VarChar(255)
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "СОСП"
model SOSP {
  id       Int    @id @default(autoincrement())
  CodeSOSP String @db.VarChar(10)

  user Users[]

  @@map("sosp")
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "ТНО"
model TNO {
  id      Int    @id @default(autoincrement())
  CodeTNO String @db.VarChar(4)

  regionId Int

  region Regions         @relation(fields: [regionId], references: [id])
  person DebtorPersons[]

  @@map("tno")
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "Регионы"
model Regions {
  id         Int     @id @default(autoincrement())
  regionCode String  @db.VarChar(4) @unique
  regionName String? @db.VarChar(128)
  sonoName   String? @db.VarChar(512)

  user Users[]
  tno  TNO[]
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "Категории должников"
model DebtorCategories {
  id       Int    @id @default(autoincrement())
  category String @db.VarChar(10)

  user Users[]

  @@map("debtor_categories")
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "Должники"
model DebtorPersons {
  id   Int    @id @default(autoincrement())
  inn  String @db.VarChar(12) @unique
  name String @db.VarChar(512)

  categoryId Int
  tnoId      Int
  sospId     Int

  category    DebtorCategories @relation(fields: [categoryId], references: [id])
  tno         TNO              @relation(fields: [tnoId], references: [id])
  sosp        SOSP             @relation(fields: [sospId], references: [id])
  resolutions Resolutions[]
  actives     Actives[]

  @@map("debtor_persons")
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "Постановления"
model Resolutions {
  id                         Int       @id @default(autoincrement())
  resolutionNumber           String    @db.Text
  resolutionDate             DateTime  @db.Date
  resolutionAmount           Float     @db.Float
  currentBalance             Float     @db.Float
  proceedingNumber           String?   @db.Text
  proceedingBeginDate        DateTime? @db.Date
  proceedingStopDate         DateTime? @db.Date
  proceedingEndDate          DateTime? @db.Date
  proceedingEndReason        String?   @db.Text
  proceedingPostponementDate DateTime? @db.Date
  proceedingTerminateDate    DateTime? @db.Date

  isArchived Boolean @default(false)
  isDerived  Boolean @default(false)

  personId Int
  person   DebtorPersons @relation(fields: [personId], references: [id])
}

//////////////////////////////////////////////////////////////////////////////////

/// Таблица "Активы должника"
model Actives {
  id                Int         @id @default(autoincrement())
  type              ActivesType
  name              String      @db.VarChar(512)
  totalSum          Float       @db.Float
  statusObject      String      @db.VarChar(10)
  otherStatusObject String      @db.VarChar(50)
  isVerified        Boolean     @default(false)
  nameLessor        String?     @db.VarChar(250)
  isDepositFNS      Boolean     @default(false)
  verifyFSSP        String?     @db.Text ////////////
  comment           String?     @db.Text

  personId Int
  person   DebtorPersons @relation(fields: [personId], references: [id])

  action ExecutiveActions?
}

model ExecutiveActions {
  id            Int @id @default(autoincrement())
  activeId      Int @unique
  arrestId      Int @unique
  wantedId      Int @unique
  evaluationId  Int @unique
  encumbranceId Int @unique

  active      Actives      @relation(fields: [activeId], references: [id])
  encumbrance Encumbrance?
  arrest      Arrests?
  wanted      Wanted?
  evaluation  Evaluation?

  @@map("executive_actions")
}

model Arrests {
  id     Int       @id @default(autoincrement())
  date   DateTime? @db.Date
  amount Float?    @db.Float

  action ExecutiveActions @relation(fields: [id], references: [arrestId])
}

model Wanted {
  id        Int       @id @default(autoincrement())
  beginDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  result    String?   @db.VarChar(20)

  action ExecutiveActions @relation(fields: [id], references: [wantedId])
}

model Evaluation {
  id        Int       @id @default(autoincrement())
  beginDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  amount    Float?    @db.Float

  action ExecutiveActions @relation(fields: [id], references: [evaluationId])
}

model Encumbrance {
  id              Int       @id @default(autoincrement())
  encumbranceType String?   @db.VarChar(250)
  encumbranceDate DateTime? @db.Date

  action ExecutiveActions @relation(fields: [id], references: [encumbranceId])
}
